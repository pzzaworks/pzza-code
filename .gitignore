# Dependencies
node_modules/
.pnp
.pnp.js

# Build output
dist/
dist-ssr/
build/
*.local

# Machine-specific overrides (never commit personal host/user/cert/keychain)
*.local.ts
src/rdp.local.ts

# Rust / Tauri
src-tauri/target/
src-tauri/gen/
src-tauri/frameworks/

# Environment / secrets
.env
.env.*
!.env.example
*.pem
*.key
id_rsa*

# Logs
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Caches
.playwright-cli/
.cache/
.vite/
.eslintcache

# Editors
.vscode/
.idea/
*.swp

# OS
.DS_Store
Thumbs.db

# Local test suite, fixtures and audit tools stay on disk only. Just the
# scripts the build and release need are tracked.
/scripts/*
!/scripts/agent-catalog.mjs
!/scripts/agent-smoke.mjs
!/scripts/fetch-onnxruntime.sh
!/scripts/release.sh
!/scripts/terminal-renderer-patch.mjs
!/scripts/terminal-renderer-patch.d.mts
