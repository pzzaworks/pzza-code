{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PzzaCode",
  "version": "0.2.9",
  "identifier": "com.pzzacode.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "PzzaCode",
        "width": 1280,
        "height": 820,
        "minWidth": 720,
        "minHeight": 480,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../server/index.js": "server/index.js",
      "../server/package.json": "server/package.json",
      "../mcp/server.js": "mcp/server.js",
      "../mcp/package.json": "mcp/package.json",
      "../install.sh": "install.sh"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
