{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PzzaCode",
  "version": "0.2.34",
  "identifier": "com.pzzacode.app",
  "build": {
    "beforeDevCommand": "npm run build:mcp && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build && npm run build:mcp",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "PzzaCode",
        "width": 1280,
        "height": 820,
        "minWidth": 720,
        "minHeight": 480,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "dragDropEnabled": true,
        "transparent": true
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "publisher": "Berke (pzzaworks)",
    "copyright": "Developed by Berke (pzzaworks)",
    "targets": "all",
    "resources": {
      "Credits.html": "Credits.html",
      "../server/index.js": "server/index.js",
      "../server/lib/*.js": "server/lib/",
      "../server/package.json": "server/package.json",
      "../build/mcp/server.js": "mcp/server.js",
      "../mcp/lib/*.js": "mcp/lib/",
      "../mcp/package.json": "mcp/package.json",
      "../install.sh": "install.sh"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "entitlements": "./Entitlements.plist"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhDMzQwMTc3MDg5ODIyNDMKUldSRElwZ0lkd0UwakpEcm9JYy95THY5QzdrK1U1dUhpT242RkVCNTBpZGoyUTRHY3lYY3V5eXUK",
      "endpoints": [
        "https://github.com/pzzaworks/pzza-code/releases/latest/download/latest.json"
      ]
    }
  }
}
