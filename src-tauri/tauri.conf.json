{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PzzaCode",
  "version": "0.2.74",
  "identifier": "com.pzzacode.app",
  "build": {
    "beforeDevCommand": "npm run fetch:onnxruntime && npm run build:mcp && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run fetch:onnxruntime && npm run build && npm run build:mcp",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "PzzaCode",
        "width": 1280,
        "height": 820,
        "minWidth": 720,
        "minHeight": 480,
        "center": true,
        "titleBarStyle": "Overlay",
        "trafficLightPosition": {
          "x": 14,
          "y": 23
        },
        "hiddenTitle": true,
        "dragDropEnabled": true,
        "transparent": true
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "publisher": "Berke (pzzaworks)",
    "copyright": "Developed by Berke (pzzaworks)",
    "targets": "all",
    "resources": {
      "Credits.html": "Credits.html",
      "../server/index.js": "server/index.js",
      "../server/lib/": "server/lib/",
      "../server/package.json": "server/package.json",
      "../build/mcp/server.js": "mcp/server.js",
      "../mcp/lib/": "mcp/lib/",
      "../mcp/package.json": "mcp/package.json",
      "../install.sh": "install.sh"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "frameworks": ["./frameworks/libonnxruntime.1.dylib"],
      "entitlements": "./Entitlements.plist"
    },
    "createUpdaterArtifacts": true,
    "fileAssociations": [
      { "name": "Plain Text", "ext": ["txt"], "role": "Editor", "rank": "Alternate" },
      { "name": "JSON", "ext": ["json"], "role": "Editor", "rank": "Alternate" },
      { "name": "XML", "ext": ["xml"], "role": "Editor", "rank": "Alternate" },
      { "name": "HTML", "ext": ["html", "htm"], "role": "Editor", "rank": "Alternate" },
      {
        "name": "Source Code",
        "ext": [
          "ts", "tsx", "mts", "cts", "js", "jsx", "mjs", "cjs",
          "py", "pyi", "rb", "go", "rs", "java", "kt", "kts", "swift",
          "c", "h", "cc", "cpp", "cxx", "hh", "hpp", "hxx", "m", "mm", "cs",
          "php", "sh", "bash", "zsh", "fish", "lua", "dart", "scala",
          "ex", "exs", "erl", "hrl", "hs", "clj", "cljs", "r", "pl", "pm",
          "vue", "svelte", "astro", "sql", "graphql", "gql", "gradle", "groovy",
          "zig", "jl", "tf", "proto"
        ],
        "role": "Editor",
        "rank": "Alternate"
      },
      {
        "name": "Stylesheet",
        "ext": ["css", "scss", "sass", "less"],
        "role": "Editor",
        "rank": "Alternate"
      },
      {
        "name": "Markdown",
        "ext": ["md", "mdx", "markdown", "rst", "adoc"],
        "role": "Editor",
        "rank": "Alternate"
      },
      {
        "name": "Configuration",
        "ext": ["jsonc", "json5", "yaml", "yml", "toml", "ini", "cfg", "conf", "env", "properties", "lock"],
        "role": "Editor",
        "rank": "Alternate"
      },
      {
        "name": "Text Data",
        "ext": ["log", "csv", "tsv", "diff", "patch"],
        "role": "Editor",
        "rank": "Alternate"
      }
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhDMzQwMTc3MDg5ODIyNDMKUldSRElwZ0lkd0UwakpEcm9JYy95THY5QzdrK1U1dUhpT242RkVCNTBpZGoyUTRHY3lYY3V5eXUK",
      "endpoints": [
        "https://github.com/pzzaworks/pzza-code/releases/latest/download/latest.json"
      ]
    }
  }
}
